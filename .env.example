APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- NATS --------------------------------------------------------------------
# 1 = use the *_TESTING_* streams and the *.testing.v1.> subjects. 0 in production.
DEV_MODE=1

NATS_HOST=127.0.0.1
NATS_PORT=4222
# NATS_USER=
# NATS_PASS=
# NATS_TOKEN=

# Stream and durable overrides. Leave these COMMENTED OUT to take the
# dev_mode-aware defaults in config/nats.php — a key present but empty
# overrides the default with "" and the consumer will not bind.
# NATS_SCHEDULING_STREAM=SCHEDULING_TESTING_EVENTS
# NATS_HIRING_STREAM=HIRING_TESTING_EVENTS
# NATS_HIRING_DURABLE=SCHEDULING_HIRING_TESTING_CONSUMER
# NATS_AUTH_STREAM=AUTH_TESTING_EVENTS
# NATS_AUTH_DURABLE=SCHEDULING_AUTH_TESTING_CONSUMER

NATS_PULL_BATCH=25
NATS_PULL_TIMEOUT_MS=2000
NATS_PULL_SLEEP_MS=250

# --- TimeClock Plus (punches in) ---------------------------------------------
TCP_BASE_URI=https://api.tcplusondemand.com/v1
TCP_AUTH_MODE=oauth
TCP_CLIENT_ID=
TCP_CLIENT_SECRET=
# Only read when TCP_AUTH_MODE=static.
TCP_STATIC_TOKEN=
TCP_AUTH_HEADER=Authorization
TCP_AUTH_PREFIX=Bearer
# Empty means send no customer header at all, not send an empty one.
TCP_CUSTOMER_ID=
TCP_PAGE_SIZE=200
TCP_RETRY_ATTEMPTS=3
TCP_TIMEOUT=30
TCP_FILTER_VALUE_CAP=20

# --- Humanity (published shifts out) -----------------------------------------
HUMANITY_BASE_URI=https://www.humanity.com/api/v2
# 'oauth' exchanges the four credentials below for a short-lived token.
# 'static' skips the token call and uses HUMANITY_STATIC_TOKEN as-is — quicker
# to get working, but it opts out of the 401 refresh, so an expired token fails
# every call until this file is edited.
HUMANITY_AUTH_MODE=oauth
HUMANITY_STATIC_TOKEN=
HUMANITY_CLIENT_ID=
HUMANITY_CLIENT_SECRET=
HUMANITY_USERNAME=
HUMANITY_PASSWORD=
# WHERE the token rides, independent of where it came from:
# '_token' query parameter, or 'bearer' header.
HUMANITY_AUTH_TRANSPORT=_token
# 'following' = this occurrence onward. 'all' deletes the WHOLE recurring series.
HUMANITY_DELETE_RULE=following
# 'reassign' = hand the shift over. 'trade' = the two employees swap shifts.
HUMANITY_SWAP_STRATEGY=reassign
HUMANITY_RETRY_ATTEMPTS=3
HUMANITY_TIMEOUT=30

# --- Authentication (pizzasys) ------------------------------------------------
# Scheduling stores no passwords. It verifies the token a request carries against
# this service on every request, and asks it the authorization question too.
AUTH_SERVICE_BASE_URI=http://localhost:8000/api/v1
# service_clients.name upstream, and what scheduling's auth rules are filed under.
AUTH_SERVICE_NAME=scheduling
# Created upstream with `php artisan service-client:create`. Plaintext lives only here.
AUTH_SERVICE_TOKEN=
# Seconds an introspection is trusted. A revoked token keeps working this long.
AUTH_SERVICE_CACHE_TTL=30
# Enforce the upstream rule decision (ext.authorized). Off still requires a token.
AUTH_SERVICE_ENFORCE_AUTHORIZATION=true
AUTH_SERVICE_TIMEOUT=5
# LOCAL DEVELOPMENT ONLY. Signs in as super-admin with the credential below and
# never contacts the auth service. Refused outside APP_ENV=local|testing whatever
# this says — see App\Services\Auth\DevBypass. Never enable it against real data.
AUTH_SERVICE_DEV_BYPASS=false
AUTH_SERVICE_DEV_BYPASS_USER=admin@admin.com
AUTH_SERVICE_DEV_BYPASS_PASSWORD=admin

# --- LC_PIZZA_DATA (sales warehouse) ------------------------------------------
# Read-only, and read on behalf of the SIGNED-IN CALLER: scheduling forwards the
# token the request arrived with, so LC_PIZZA_DATA makes the same store-scope
# decision it would if the manager had called it directly. There is deliberately
# no service token here — nothing may read a store's takings that the person
# looking at the screen could not read for themselves.
# INCLUDE the /api prefix: the warehouse registers these routes in api.php.
LC_DATA_BASE_URI=http://localhost:8001/api
# Off renders the week grid exactly as it did before the sales row existed:
# no column, no request, no log line.
LC_DATA_ENABLED=true
# The hours the column shows, store-local and inclusive. 10 to 23 is
# "10AM until midnight" — the 23:00 bucket is the last one inside the window.
LC_DATA_WINDOW_FROM_HOUR=10
LC_DATA_WINDOW_TO_HOUR=23
# A finished business date does not change again; today's is still being made.
LC_DATA_CACHE_CLOSED_TTL=21600
LC_DATA_CACHE_OPEN_TTL=300
# Small budgets: this sits on the board render path, and a manager waiting on a
# grid would rather see a dash than a spinner.
LC_DATA_RETRY_ATTEMPTS=2
LC_DATA_TIMEOUT=5
# A token to send when the caller has none of their own — the dev bypass signs
# a session in with a sentinel string, not a real token, so there is nothing to
# forward and the sales column can never render. Honoured ONLY in local and
# testing (the check is in LcDataClient, not here). It must be a token
# LC_PIZZA_DATA's own auth.token.store middleware will accept.
LC_DATA_DEV_TOKEN=
# Draw the column from a local generator instead of calling the warehouse.
# LOCAL AND TESTING ONLY. Reproduces HourlyStoreSalesSeeder's arithmetic exactly,
# so the preview matches what a seeded warehouse would return. The grid labels
# the column SAMPLE whenever this is on — the figures are invented.
LC_DATA_STUB=false
